generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  role      String     @default("STAFF")
  adverts   Advertisement[]
  auditLogs AuditLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id                     String          @id @default(cuid())
  name                   String
  sku                    String          @unique
  primarySpecification   String
  secondarySpecification String?
  feature01              String?
  feature02              String?
  keyBenefit             String?
  imagePath              String?
  adverts                Advertisement[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model Advertisement {
  id                     String               @id @default(cuid())
  productName            String
  sku                    String
  primarySpecification   String
  secondarySpecification String?
  feature01              String?
  feature02              String?
  keyBenefit             String?
  campaignType           String
  campaignMessage        String
  sellingPrice           Int
  disclaimer             String               @default("WHILE STOCKS LAST")
  moodId                  String
  productImage           String
  qrUrl                   String               @default("https://www.toolhub.co.za")
  templateVersion        String               @default("TOOLHUB_SOCIAL_MASTER_V1")
  status                  String               @default("DRAFT")
  authorId                String?
  productId               String?
  templateId              String?
  author                  User?                @relation(fields: [authorId], references: [id])
  product                 Product?             @relation(fields: [productId], references: [id])
  mood                    MascotMood            @relation(fields: [moodId], references: [id])
  template                Template?             @relation(fields: [templateId], references: [id])
  assets                  AdvertisementAsset[]
  auditLogs               AuditLog[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AdvertisementAsset {
  id              String        @id @default(cuid())
  advertisementId String
  type            String
  path            String
  mimeType        String?
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
}

model MascotMood {
  id            String          @id
  displayName   String
  assetPath     String
  thumbnailPath String
  active        Boolean         @default(true)
  defaultScale  Float           @default(1)
  xPosition     Float           @default(0)
  yPosition     Float           @default(0)
  adverts       Advertisement[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Template {
  id          String          @id @default(cuid())
  version     String          @unique
  name        String
  description String?
  active      Boolean         @default(true)
  adverts     Advertisement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AuditLog {
  id              String         @id @default(cuid())
  action          String
  entityType      String
  entityId        String
  metadata        String?
  userId          String?
  advertisementId String?
  user             User?         @relation(fields: [userId], references: [id])
  advertisement    Advertisement? @relation(fields: [advertisementId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())

  @@index([entityType, entityId])
}

