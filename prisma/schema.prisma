generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id
  email           String          @unique
  name            String
  role            String          @default("STAFF")
  createdAdverts  Advertisement[] @relation("AdvertCreator")
  editedAdverts   Advertisement[] @relation("AdvertEditor")
  submittedAdverts Advertisement[] @relation("AdvertSubmitter")
  approvedAdverts Advertisement[] @relation("AdvertApprover")
  rejectedAdverts Advertisement[] @relation("AdvertRejector")
  createdProducts Product[]       @relation("ProductCreator")
  updatedProducts Product[]       @relation("ProductUpdater")
  auditLogs       AuditLog[]
  socialPosts     SocialPost[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Product {
  id                       String          @id @default(cuid())
  sku                      String          @unique
  barcode                  String?
  brand                    String          @default("INGCO")
  productName              String
  category                 String          @default("Tools")
  primarySpecification     String
  secondarySpecification   String?
  feature01                String?
  feature02                String?
  keyBenefit               String?
  normalPrice              Int?
  currentPrice             Int
  websiteUrl               String?
  originalImageUrl         String          @default("")
  processedImageUrl        String?
  backgroundRemovalStatus  String          @default("PENDING")
  active                   Boolean         @default(true)
  createdByUserId          String?
  updatedByUserId          String?
  createdBy                User?           @relation("ProductCreator", fields: [createdByUserId], references: [id])
  updatedBy                User?           @relation("ProductUpdater", fields: [updatedByUserId], references: [id])
  adverts                  Advertisement[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([productName])
  @@index([barcode])
  @@index([brand])
  @@index([category])
  @@index([active])
}

model Advertisement {
  id                       String               @id @default(cuid())
  productId                String?
  createdByUserId          String               @default("dev-staff-1")
  lastEditedByUserId       String               @default("dev-staff-1")
  productName              String
  sku                      String
  primarySpecification     String
  secondarySpecification   String?
  feature01                String?
  feature02                String?
  keyBenefit               String?
  campaignType             String
  campaignMessage          String
  sellingPrice             Int
  disclaimer               String               @default("WHILE STOCKS LAST")
  moodId                    String
  productImage             String
  originalImageUrl         String               @default("")
  processedImageUrl        String?
  backgroundRemovalStatus  String               @default("PENDING")
  useOriginalImage         Boolean              @default(false)
  qrUrl                    String               @default("https://www.toolhub.co.za")
  templateVersion          String               @default("TOOLHUB_SOCIAL_MASTER_V1")
  status                   String               @default("DRAFT")
  submittedAt              DateTime?
  submittedByUserId        String?
  approvedAt               DateTime?
  approvedByUserId         String?
  rejectedAt               DateTime?
  rejectedByUserId         String?
  approvalComment          String?
  templateId               String?
  product                  Product?             @relation(fields: [productId], references: [id])
  createdBy                User                 @relation("AdvertCreator", fields: [createdByUserId], references: [id])
  lastEditedBy             User                 @relation("AdvertEditor", fields: [lastEditedByUserId], references: [id])
  submittedBy              User?                @relation("AdvertSubmitter", fields: [submittedByUserId], references: [id])
  approvedBy               User?                @relation("AdvertApprover", fields: [approvedByUserId], references: [id])
  rejectedBy               User?                @relation("AdvertRejector", fields: [rejectedByUserId], references: [id])
  mood                     MascotMood            @relation(fields: [moodId], references: [id])
  template                 Template?             @relation(fields: [templateId], references: [id])
  assets                   AdvertisementAsset[]
  auditLogs                AuditLog[]
  socialPosts              SocialPost[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([status])
  @@index([createdByUserId])
  @@index([submittedAt])
  @@index([createdAt])
}

model AdvertisementAsset {
  id              String        @id @default(cuid())
  advertisementId String
  type            String
  path            String
  mimeType        String?
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
}

model MascotMood {
  id            String          @id
  displayName   String
  assetPath     String
  thumbnailPath String
  active        Boolean         @default(true)
  defaultScale  Float           @default(1)
  xPosition     Float           @default(0)
  yPosition     Float           @default(0)
  adverts       Advertisement[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Template {
  id          String          @id @default(cuid())
  version     String          @unique
  name        String
  description String?
  active      Boolean         @default(true)
  adverts     Advertisement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AuditLog {
  id              String         @id @default(cuid())
  action          String
  entityType      String
  entityId        String
  metadata        String?
  previousStatus  String?
  newStatus       String?
  userId          String?
  userName        String?
  advertisementId String?
  socialPostId     String?
  user             User?         @relation(fields: [userId], references: [id])
  advertisement    Advertisement? @relation(fields: [advertisementId], references: [id], onDelete: SetNull)
  socialPost       SocialPost?     @relation(fields: [socialPostId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([advertisementId, createdAt])
  @@index([socialPostId, createdAt])
}

model ApplicationSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialChannel {
  id                String              @id @default(cuid())
  provider          String              @default("BUFFER")
  providerChannelId String              @unique
  organizationId    String
  service           String
  name              String
  displayName       String?
  connectedStatus   String              @default("UNKNOWN")
  active            Boolean             @default(true)
  publishingEnabled Boolean             @default(false)
  metadata          String?
  lastSyncedAt      DateTime?
  postChannels      SocialPostChannel[]
  attempts          PublishingAttempt[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([organizationId])
  @@index([service])
  @@index([active, publishingEnabled])
}

model SocialPost {
  id                    String              @id @default(cuid())
  idempotencyKey        String              @unique
  advertisementId       String
  caption               String
  status                String              @default("DRAFT")
  mode                  String              @default("SCHEDULE")
  scheduledAt           DateTime?
  timezone              String              @default("Africa/Johannesburg")
  finalArtworkUrl       String
  finalArtworkData      String?
  finalArtworkCreatedAt DateTime             @default(now())
  dryRun                Boolean              @default(true)
  createdByUserId       String
  publishedAt           DateTime?
  advertisement         Advertisement       @relation(fields: [advertisementId], references: [id])
  createdBy             User                @relation(fields: [createdByUserId], references: [id])
  channels              SocialPostChannel[]
  attempts              PublishingAttempt[]
  auditLogs             AuditLog[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([advertisementId])
  @@index([status])
  @@index([scheduledAt])
}

model SocialPostChannel {
  id                String        @id @default(cuid())
  socialPostId      String
  socialChannelId   String
  status            String        @default("READY")
  providerPostId    String?
  providerStatus    String?
  providerDueAt     DateTime?
  providerResponse  String?
  errorCode         String?
  errorMessage      String?
  attemptCount      Int           @default(0)
  intendedSchedule DateTime?
  socialPost        SocialPost    @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  socialChannel     SocialChannel @relation(fields: [socialChannelId], references: [id])
  attempts          PublishingAttempt[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([socialPostId, socialChannelId, intendedSchedule])
  @@index([status])
}

model PublishingAttempt {
  id                  String             @id @default(cuid())
  socialPostId        String
  socialPostChannelId String
  channelId           String
  attemptNumber       Int
  action              String
  requestedAt         DateTime           @default(now())
  completedAt         DateTime?
  success             Boolean?
  provider            String             @default("BUFFER")
  providerPostId      String?
  errorCode           String?
  errorMessage        String?
  responseMetadata    String?
  socialPost          SocialPost         @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  socialPostChannel   SocialPostChannel  @relation(fields: [socialPostChannelId], references: [id], onDelete: Cascade)
  channel             SocialChannel      @relation(fields: [channelId], references: [id])

  @@index([socialPostId, requestedAt])
  @@index([socialPostChannelId, attemptNumber])
}
