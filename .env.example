DATABASE_URL="file:./dev.db"
# Authentication fails closed if these are missing. There is no environment identity fallback.
AUTH_MODE="supabase"
APP_URL="http://localhost:3100"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Server-only: storage and trusted operator onboarding, never browser code.
SUPABASE_SERVICE_ROLE_KEY=""
# Server-only 32-byte random key encoded as 64 hexadecimal characters.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY=""
# Demo products/users are opt-in and disabled in production.
TOOLHUB_SEED_DEMO="false"
SOCIAL_PUBLISHING_MODE="dry-run"
AUTO_SCHEDULING_MODE="manual"
PHOTOROOM_API_KEY=""

# Phase 4 AI defaults to deterministic mock mode.
AI_MODE="mock"
AI_PROVIDER="openai"
AI_MODEL=""
OPENAI_API_KEY=""
# Live-only, server-side secrets:
# BUFFER_API_KEY=""
# BUFFER_ORGANIZATION_ID=""
# SUPABASE_STORAGE_BUCKET="toolhub-social"
